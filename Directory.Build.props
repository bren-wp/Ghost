<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>BRENDIGO LTD</Authors>
    <Company>BRENDIGO LTD</Company>
    <Product>Ghost FTP</Product>
    <Copyright>Copyright © 2026 BRENDIGO LTD. All rights reserved.</Copyright>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <InformationalVersion>1.6.0</InformationalVersion>
    <RepositoryUrl>https://github.com/bren-wp/Ghost</RepositoryUrl>
    <PackageProjectUrl>https://ghostftp.com</PackageProjectUrl>
  </PropertyGroup>
</Project>
